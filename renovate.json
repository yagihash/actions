{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>yagihash/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Automerge npm minor/patch updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update ghalint and actionlint versions in ghalint workflow",
      "fileMatch": [
        "^\\.github/workflows/ghalint\\.yml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+version=v?(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
